[Unit]
Description=Forgejo Git Service
After=network-online.target

[Container]
Image=codeberg.org/forgejo/forgejo:17.0.1
NoNewPrivileges=true
ContainerName=forgejo
Pod=forgejo.pod

EnvironmentFile=%h/.env.forgejo

Volume=forgejo-data:/data

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
